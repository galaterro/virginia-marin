---
const year = new Date().getFullYear();
---

<footer>
  <p class="name">Virginia Marin</p>
  <p class="legal">© {year} Virginia Marin · Todas las fotografías son de autoría propia</p>
</footer>

<style>
  footer {
    text-align: center;
    padding: 3rem 1rem 2.5rem;
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }

  .name {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }

  .legal {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
