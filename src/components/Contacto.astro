---
import { Image } from "astro:assets";
import SectionTitle from "./SectionTitle.astro";
import firma from "../assets/images/contacto-firma-libros.jpg";

const redes = [
  { href: "https://www.goodreads.com/author/show/22011709.Virginia_Mar_n", label: "Goodreads" },
  { href: "https://substack.com/@virpmar", label: "Substack" },
  { href: "https://www.instagram.com/virpmar/", label: "Instagram" },
];
---

<section id="contacto" class="section">
  <div class="container">
    <SectionTitle es="Contacto" en="Contact" />

    <div class="cols">
      <div class="side">
        <figure class="frame">
          <Image
            src={firma}
            alt="Fotografía en blanco y negro de la autora Virginia Marín firmando ejemplares de sus libros en la Feria del Libro de Madrid"
            class="photo"
            widths={[300, 450, 700]}
            sizes="(max-width: 820px) 320px, 300px"
            width={700}
            height={817}
          />
          <figcaption>Redes sociales / <span lang="en">Social media</span>:</figcaption>
        </figure>
        <ul class="social">
          {
            redes.map((red) => (
              <li>
                <a href={red.href} target="_blank" rel="noopener">
                  {red.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="main">
        <p class="intro">
          Para trabajar o colaborar en algún proyecto puedes escribirme a través del siguiente formulario:
        </p>
        <p class="intro" lang="en">
          Please, if you wish to contact me you can get in touch through this form:
        </p>

        <h3 class="form-title">
          Formulario de contacto <small lang="en">Contact form</small>
        </h3>

        <!--
          Formulario preparado para Netlify Forms (funciona solo al desplegar en Netlify).
          Si al final se despliega en Cloudflare Pages, cambiarlo a un servicio tipo
          Web3Forms/Formspree: action="https://..." y quitar los atributos data-netlify.
        -->
        <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contacto" />
          <p class="hidden" aria-hidden="true">
            <label>No rellenar: <input name="bot-field" /></label>
          </p>
          <label>
            <span class="lbl">Nombre <span class="en" lang="en">Name</span></span>
            <input type="text" name="nombre" required />
          </label>
          <label>
            <span class="lbl">Email <span class="en" lang="en">Email address</span></span>
            <input type="email" name="email" required />
          </label>
          <label>
            <span class="lbl">Mensaje <span class="en" lang="en">Your message</span></span>
            <textarea name="mensaje" rows="6" required></textarea>
          </label>
          <button class="btn submit" type="submit">Enviar <span lang="en">/ Send</span></button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 6 / 7;
    object-fit: cover;
  }

  .frame figcaption {
    text-align: center;
    font-size: 1.05rem;
    padding: 0.7rem 0 0.9rem;
  }

  .social {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.7rem;
    justify-items: center;
  }

  .intro {
    text-align: center;
    margin: 0;
  }

  .intro[lang="en"] {
    color: var(--ink-soft);
    margin-bottom: 2.5rem;
  }

  .form-title {
    font-weight: 500;
    font-size: 1.75rem;
    letter-spacing: 0.02em;
    color: var(--accent-soft);
    margin: 0 0 1.5rem;
  }

  .form-title small {
    display: block;
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }

  .hidden {
    display: none;
  }

  form label {
    display: block;
    margin-bottom: 1.2rem;
  }

  .lbl {
    display: block;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }

  .lbl .en {
    color: var(--ink-soft);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  form input,
  form textarea {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.6rem 0.8rem;
    font-family: inherit;
    font-size: 1.05rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  form input:focus,
  form textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }

  .submit {
    width: 100%;
    border-radius: 6px;
    padding: 0.75rem 1.6rem;
  }

  /* Mismo blanco que el resto del botón: un blanco atenuado no llegaría al 4.5:1 */
  .submit span {
    font-size: 0.92em;
    letter-spacing: 0.1em;
  }

  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .side .frame {
      max-width: 320px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
