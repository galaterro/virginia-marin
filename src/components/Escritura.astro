---
import { Image } from "astro:assets";
import BotanicalBand from "./BotanicalBand.astro";
import SectionTitle from "./SectionTitle.astro";
import vocesDeBosqueCover from "../assets/images/voces-de-bosque-portada.jpg";
import premioEnElMar from "../assets/images/si-pudiera-ser-ave-premio.jpg";

const poemas = [
  {
    href: "https://digopalabratxt.com/2025/01/05/tres-poemas-de-virginia-marin-espana/",
    label: "Revista Digo.Palabra",
  },
  {
    href: "https://aullidolit.com/genocidio-inedito-muestra-poesia-virginia-marin/",
    label: "Revista Aullido",
  },
  { href: "https://ko-fi.com/s/4aca6e8dff", label: "Fanzine Arrebol - Tierra" },
  { href: "https://ko-fi.com/s/54276300ee", label: "Fanzine Arrebol - Animal" },
  { href: "https://ko-fi.com/s/5c7287f3a7", label: "Fanzine Arrebol - Cosmos" },
];

const resenas = [
  "Un paseo poético e íntimo por la naturaleza, escrito en una prosa limpia, pero cargada de belleza y asombro.",
  "La poesía gótica, ecofeminista y apocalíptica de Virginia guarda entre sus versos embarrados palabras bellísimas con imágenes oscuras y terribles.",
  "Voces de bosque es un libro profundamente personal y escrito con una sensibilidad extraordinaria. A través de sus paseos por un bosque del sur de Inglaterra, la autora nos invita a descubrir un paisaje bucólico y a sus habitantes, a través de una mirada poética muy personal. El bosque no es solo un escenario, es también un espejo en el que la autora se va encontrando a sí misma. Sus sensaciones, sus pensamientos y su experiencia personal se entrelazan con la naturaleza de una forma muy delicada y conmovedora. Un libro inolvidable en el que la naturaleza se transforma en refugio, espejo y respuesta.",
  "Virginia da voz a todas las voces, nos arrastra como ceniza para escribir un incendio (...) su originalidad y sensibilidad, un libro coral con seres que hablan sin voz, por removernos la mirada y por hacernos seres mutables de este proceso, de esta transformación (...)",
];
---

<section id="escritura" class="section section--alt">
  <div class="container">
    <SectionTitle es="Escritura" en="Writing" />

    <div class="cols">
      <div>
        <h3 class="col-title">Libros publicados</h3>

        <article class="book">
          <Image
            src={vocesDeBosqueCover}
            alt="Cubierta del libro Voces de bosque, de Virginia Marín"
            class="cover"
            width={400}
            height={600}
          />
          <div>
            <p class="verse">hay crisálidas entre mis costillas<br />pelaje de corzo bajo mis fascias</p>
            <h4>Voces de bosque</h4>
            <p class="genre">Prosa poética, literatura</p>
            <p>
              Una historia en primera persona sobre mi vida en UK en un bosque centenario, repleta de
              avistamientos salvajes y amor por la naturaleza.
            </p>
            <a
              class="btn"
              href="https://www.tundraediciones.es/index.php?option=com_virtuemart&view=productdetails&virtuemart_product_id=905&virtuemart_category_id=25&lang=es"
              target="_blank"
              rel="noopener"
            >
              Comprar
            </a>
          </div>
        </article>

        <article class="book">
          <Image
            src={premioEnElMar}
            alt="Página del accésit del V premio En el Mar para el poemario Si pudiera ser ave y traer un río en la boca"
            class="cover"
            width={400}
            height={600}
          />
          <div>
            <p class="verse">me despierto con rescoldos en la lengua<br />y ceniza entre los párpados</p>
            <h4>Si pudiera ser ave y traer un río en la boca</h4>
            <p class="genre">Poesía</p>
            <p>
              Ganador del accésit del V premio en el mar.<br />Previsto para finales de 2026.
            </p>
            <a class="btn" href="https://www.edicionesenelmar.com/premio-en-el-mar/" target="_blank" rel="noopener">
              Saber más
            </a>
          </div>
        </article>

        <h3 class="col-title poems-title">Poemas publicados en revistas y fanzines</h3>
        <ul class="poems">
          {
            poemas.map((poema) => (
              <li>
                <a href={poema.href} target="_blank" rel="noopener">
                  {poema.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside>
        <h3 class="col-title">Han dicho de sus obras...</h3>
        {
          resenas.map((resena, i) => (
            <>
              {i > 0 && <div class="divider" role="presentation"><span /></div>}
              <blockquote>{resena}</blockquote>
            </>
          ))
        }
      </aside>
    </div>

    <div class="substack">
      <h3 class="col-title">Artículos de Substack</h3>
      <p><a href="https://virpmar.substack.com" target="_blank" rel="noopener">océanos y conjuros</a></p>
    </div>

    <BotanicalBand maxWidth="760px" />
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 3.5rem;
  }

  .book {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 2.8rem;
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  /* El verso va sobre el título del libro, en la manuscrita del título del hero.
     Water Brush tiene una altura de x pequeña, así que necesita más cuerpo que
     una manuscrita normal para leerse al mismo tamaño aparente. El `clamp` evita
     que en móvil los versos rompan a media línea y pierdan su forma de dos
     versos: a 1.9rem el más largo no cabe junto a la portada. */
  .verse {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 5vw, 1.9rem);
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 1rem;
  }

  .book h4 {
    margin: 0 0 0.2rem;
    font-size: 1.3rem;
    font-weight: 500;
    font-style: italic;
    color: var(--accent-text);
  }

  .book p {
    margin: 0 0 0.7rem;
  }

  .genre {
    font-weight: 600;
  }

  .poems-title {
    text-align: left;
    margin-top: 2.5rem;
  }

  .poems {
    margin: 0;
    padding-left: 1.6rem;
  }

  .poems li {
    margin-bottom: 0.7rem;
  }

  .poems a {
    font-style: italic;
  }

  aside blockquote {
    margin: 0;
    font-style: italic;
    text-align: center;
    color: var(--ink);
  }

  .substack {
    margin-top: 3.5rem;
    text-align: center;
  }

  .substack p {
    margin: 0;
  }

  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .book {
      grid-template-columns: 100px 1fr;
      gap: 1rem;
    }
  }
</style>
