---
// El diseño de Canva no muestra títulos de sección (la navegación hace de marcador),
// pero se mantienen en el HTML como encabezados para lectores de pantalla y buscadores.
interface Props {
  es: string;
  en: string;
}

const { es, en } = Astro.props;
---

<div class="visually-hidden">
  <h2>{es}</h2>
  <small lang="en">{en}</small>
</div>
