---
import { navLinks } from "../data/nav";

interface Props {
  // "hero" se superpone sobre la foto de portada; "sticky" es la barra que
  // aparece al dejar atrás el hero.
  variant?: "hero" | "sticky";
}

const { variant = "sticky" } = Astro.props;
---

<nav class:list={["site-nav", `site-nav--${variant}`]} aria-label="Secciones">
  <ul>
    {
      navLinks.map((link) => (
        <li>
          <a href={link.href}>
            <span class="es">{link.es}</span>
            <span class="en">{link.en}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // La barra fija sólo se muestra cuando el hero (que ya lleva su propia nav)
  // deja de estar a la vista.
  const sticky = document.querySelector(".site-nav--sticky");
  const hero = document.querySelector("#inicio");

  if (sticky && hero) {
    new IntersectionObserver(
      ([entry]) => sticky.classList.toggle("is-visible", !entry.isIntersecting),
      { rootMargin: "-70px 0px 0px 0px" },
    ).observe(hero);
  }
</script>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0.8rem 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 2.2rem;
  }

  a {
    display: grid;
    justify-items: center;
    text-decoration: none;
    color: var(--ink);
  }

  .es {
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  .en {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
  }

  a:hover .es {
    color: var(--accent-dark);
  }

  /* Nav superpuesta sobre la foto del hero. El tamaño (24.8px) reproduce el del
     Canva y además mantiene las etiquetas en el umbral de "texto grande", que
     es lo que permite usar el violeta del título sobre la foto sin oscurecerlo
     más. Si se reduce por debajo de 24px hay que bajar --title a violet-950
     (#2f0d68). */
  .site-nav--hero .es {
    font-size: 1.55rem;
    color: var(--title);
    text-shadow: 0 1px 3px rgb(255 255 255 / 0.55);
  }

  .site-nav--hero .en {
    color: #323138;
    text-shadow: 0 1px 3px rgb(255 255 255 / 0.55);
  }

  /* Barra fija: oculta hasta pasar el hero */
  .site-nav--sticky {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    background: rgb(247 245 240 / 0.94);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
    opacity: 0;
    translate: 0 -100%;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      translate 0.25s ease;
  }

  .site-nav--sticky.is-visible {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav--sticky {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    ul {
      gap: 0.3rem 0.9rem;
    }

    .es {
      font-size: 0.85rem;
    }

    .en {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }

    /* En el hero no baja de 24px: por debajo, el azul dejaría de cumplir. */
    .site-nav--hero .es {
      font-size: 1.5rem;
    }
  }
</style>
