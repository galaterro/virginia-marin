---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SiteNav from "../components/SiteNav.astro";
import Biografia from "../components/Biografia.astro";
import Escritura from "../components/Escritura.astro";
import Traduccion from "../components/Traduccion.astro";
import Fotografia from "../components/Fotografia.astro";
import Contacto from "../components/Contacto.astro";
---

<Layout>
  <!-- El hero lleva su propia navegación superpuesta; esta barra aparece al dejarlo atrás. -->
  <SiteNav variant="sticky" />
  <Hero />
  <main>
    <Biografia />
    <Escritura />
    <Traduccion />
    <Fotografia />
    <Contacto />
  </main>
</Layout>
