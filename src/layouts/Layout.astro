---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Virginia Marin — Escritora, traductora y poeta",
  description = "Página personal de Virginia Marin: escritura, traducción literaria y fotografía de naturaleza.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {/* Sólo se precargan las variantes visibles sin hacer scroll: el título del
        hero y la redonda del cuerpo. Caveat aparece en Escritura, más abajo. */}
    <Font cssVariable="--font-water-brush" preload />
    <Font cssVariable="--font-cormorant" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-caveat" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
